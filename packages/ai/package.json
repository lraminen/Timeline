{
  "name": "@chronicle/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Pluggable AI providers, document extraction, date normalization, conflict detection, summaries, and alt text for Chronicle",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "import": "./dist/documents.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chronicle/schema": "workspace:*",
    "fflate": "0.8.2",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.13.1",
    "unpdf": "^2.2.2",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
