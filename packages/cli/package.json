{
  "name": "@chronicle/cli",
  "version": "0.1.0",
  "description": "CLI for validation, export, and dev server",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "chronicle": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chronicle/schema": "workspace:*",
    "@chronicle/core": "workspace:*"
  }
}
