{
  "name": "@chronicle/cli",
  "version": "0.1.0",
  "description": "Chronicle command line: validate timelines, convert TimelineJS, export static sites",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "chronicle": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chronicle/schema": "workspace:*",
    "@chronicle/static": "workspace:*",
    "@chronicle/web-component": "workspace:*"
  },
  "private": true,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9",
    "fflate": "0.8.2"
  }
}
