{
  "name": "@chronicle/collab",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaboration for Chronicle: the Yjs document model for timelines, the sync/presence wire protocol and a WebSocket client",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chronicle/schema": "workspace:*",
    "lib0": "0.2.120",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
