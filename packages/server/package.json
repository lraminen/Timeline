{
  "name": "@chronicle/server",
  "version": "0.1.0",
  "private": true,
  "description": "Chronicle API server: REST API, auth, revisions, media, public embeds and SSR pages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "chronicle-server": "./dist/main.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.716.0",
    "@chronicle/ai": "workspace:*",
    "@chronicle/collab": "workspace:*",
    "@chronicle/core": "workspace:*",
    "@chronicle/schema": "workspace:*",
    "@chronicle/static": "workspace:*",
    "@chronicle/web-component": "workspace:*",
    "@electric-sql/pglite": "0.2.15",
    "@fastify/cookie": "11.0.1",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/websocket": "11.0.2",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.38.3",
    "fastify": "5.2.0",
    "file-type": "19.6.0",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "sharp": "0.33.5",
    "undici": "^8.13.1",
    "ws": "8.18.3",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.11.10",
    "@types/ws": "8.18.1",
    "aws-sdk-client-mock": "4.1.0",
    "drizzle-kit": "0.30.1",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9",
    "fflate": "0.8.2"
  }
}
