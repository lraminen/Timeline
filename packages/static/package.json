{
  "name": "@chronicle/static",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained static site export for Chronicle timelines (works from file://, built for long-term preservation)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chronicle/core": "workspace:*",
    "@chronicle/schema": "workspace:*",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
