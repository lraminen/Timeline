{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chronicle/timeline",
  "title": "Chronicle Timeline",
  "category": "embed",
  "description": "Embed an interactive, accessible Chronicle timeline.",
  "keywords": ["timeline", "chronology", "history", "events", "chronicle"],
  "textdomain": "chronicle-timeline",
  "attributes": {
    "slug": { "type": "string", "default": "" },
    "server": { "type": "string", "default": "" },
    "version": { "type": "integer", "default": 0 },
    "layout": { "type": "string", "enum": ["", "horizontal", "vertical", "card"], "default": "" },
    "theme": {
      "type": "string",
      "enum": ["", "light", "dark", "editorial", "minimal"],
      "default": ""
    },
    "height": { "type": "string", "default": "" },
    "filterTags": { "type": "string", "default": "" }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "spacing": { "margin": true }
  },
  "example": {},
  "editorScript": "chronicle-timeline-editor",
  "style": "chronicle-timeline"
}
