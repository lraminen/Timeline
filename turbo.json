{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@chronicle/wordpress#build": {
      "dependsOn": ["^build"],
      "outputs": ["plugin/build/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build", "@chronicle/server#build"],
      "cache": false
    }
  }
}
